{
  "name": "kodo-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Kodo desktop GUI (Tauri + React)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljx240/kodo.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/lib/tsc.js --noEmit && node ./node_modules/vite/bin/vite.js build",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "test:contrast": "node scripts/contrast-audit.mjs",
    "test:imports": "node scripts/audit-production-imports.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "lucide-react": "^1.46.0",
    "prettier": "^3.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0"
  }
}
