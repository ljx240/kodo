# Build artifacts
/target/
**/target/
node_modules/
dist/
apps/desktop/src-tauri/gen/

# Test output
apps/desktop/test-results/
playwright-report/
# Visual baselines are platform-specific: macOS baselines (`*-darwin.png`) are
# committed so the visual CI job on macos runners can compare without regenerating
# snapshots. Non-darwin baselines stay local-only until generated on that OS.
apps/desktop/tests/**/*-snapshots/*-linux.png
apps/desktop/tests/**/*-snapshots/*-win32.png
coverage/
lcov.info

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local runtime state (never commit secrets or machine logs)
*.log
credentials.log
settings.log
projects.log
sessions/

# Env / keys
.env
.env.*
*.pem
*.key
